#!/bin/sh
# Git pre-commit hook: запускает phpstan и блокирует коммит при ошибках
# Уровень можно переопределить переменной окружения PHPSTAN_LEVEL (по умолчанию 9).

PHPSTAN="vendor/bin/phpstan"
if [ ! -x "$PHPSTAN" ]; then
    # fallback на возможный бинарник в Windows-пакете
    PHPSTAN="vendor/bin/phpstan"
fi

echo "Running phpstan..."
"$PHPSTAN" analyse -l ${PHPSTAN_LEVEL:-9} -c phpstan.neon --memory-limit=1G
RESULT=$?
if [ $RESULT -ne 0 ]; then
    echo "phpstan failed. Aborting commit."
    exit 1
fi

exit 0
